generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Department {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String
}

// Números de chip do aparelho — embutido no Phone, sem coleção própria.
type PhoneChip {
  id      String
  label   String
  number  String
  carrier String?
}

// Número do celular que não é um chip físico.
// kind: "whatsapp" (WhatsApp logado sem o chip neste aparelho), "api"
// (número de WhatsApp API) ou "esim". Registros antigos sem kind são
// tratados como "whatsapp". provider: provedor do número de API.
type ExtraNumber {
  id       String
  label    String
  number   String
  kind     String?
  provider String?
}

// Guarda o id de um PhoneChip ou de um ExtraNumber (o pool de números
// selecionáveis pro WhatsApp é a união dos dois).
type WhatsAppAssignments {
  normal   String?
  business String?
}

model Phone {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  model        String
  chips        PhoneChip[]
  extraNumbers ExtraNumber[]
  whatsapp     WhatsAppAssignments
  caseColor    String?
  departmentId String?       @db.ObjectId
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Cadastro geral de números da empresa (chips, eSIMs, números de API,
// fixos...), independente de estarem num celular. A ligação com os aparelhos
// é feita pelos dígitos do número.
model NumberRecord {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  number    String // só dígitos, com DDD
  kind      String // chip | esim | api | fixo | whatsapp
  carrier   String? // operadora
  owner     String? // responsável / setor
  plan      String? // pre | pos
  recharges DateTime[] // datas de recarga (pré-pago)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
